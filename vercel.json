{
  "buildCommand": "npm run build:demo",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "feat/frontend-perfect-mock": false,
      "feat/personnel-processes-prototype": false,
      "fix/browser-qa-org-tabs": false,
      "feat/personnel-processes-prototype-v2": false,
      "fix/org-diagram-horizontal-scroll-only": false,
      "feat/documents-prototype-v2": false,
      "feat/documents-ui-parity-final": false,
      "feat/timesheets-prototype": false,
      "feat/reports-analytics-prototype": false,
      "fix/directories-prototype-parity": false,
      "feat/settings-workspace": false,
      "feat/leaves-prototype": false,
      "chore/remove-dead-placeholders": false,
      "refactor/development-registry-parity-final": false,
      "fix/login-design-system-parity": false,
      "fix/shared-ui-semantic-tokens": false,
      "feat/worktime-api-integration": false,
      "feat/leave-api-integration": false,
      "feat/access-projection-ui": false
    }
  }
}
