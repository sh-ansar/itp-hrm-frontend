# This file belongs ONLY inside /hrm/ static dist.
# No changes to the parent platform Apache site are required.
Options -Indexes -MultiViews
DirectoryIndex index.html
RewriteEngine On
# Force HTTPS only for HRM; leave platform and Unityre HTTP behavior unchanged.
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://platform.itpmining.kz%{REQUEST_URI} [R=301,L,NE]
RewriteBase /hrm/
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set Referrer-Policy "same-origin"
</IfModule>
