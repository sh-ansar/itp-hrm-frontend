{
  "buildCommand": "npm run build:demo",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "feat/frontend-perfect-mock": false,
      "feat/personnel-processes-prototype": false,
      "fix/browser-qa-org-tabs": false,
      "feat/personnel-processes-prototype-v2": false,
      "fix/org-diagram-horizontal-scroll-only": false
    }
  }
}
