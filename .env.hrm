# Static Vue build under platform.itpmining.kz/hrm/.
# No credentials or backend tokens belong in a Vite environment file.
VITE_APP_BASE_PATH=/hrm/
VITE_BACKEND_PREFIX=/hrm-api
VITE_API_BASE_URL=/hrm-api/api/v1
# This must match HRM_XSRF_COOKIE_NAME in the dedicated Laravel service.
# Do not reuse platform's XSRF-TOKEN cookie when sharing a hostname.
VITE_XSRF_COOKIE_NAME=HRM-XSRF-TOKEN
VITE_ENABLE_BROWSER_LOGIN=true
VITE_DEMO_MODE=false
